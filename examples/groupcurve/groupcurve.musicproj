<?xml version="1.0" encoding="UTF-8"?>
<!-- 轨道组 + 自动化曲线 + 部分音效 + 周期重复：8 小节 / 16 秒 -->
<musicproj name="Group &amp; Curve" bpm="120" sampleRate="44100" beatsPerBar="4"
           length="32" masterGain="-1dB" normalize="true">
  <group name="Drums" gain="-2dB">
    <effect type="compressor" threshold="-18" ratio="4" release="90" makeup="2"/>
    <effect type="tape" drive="0.25" tone="0.6" mix="0.45"/>
    <!-- 结尾 2 小节整体收掉，不需要逐轨写音量 -->
    <automation target="gain" points="0:0; 24:0; 32:-30"/>
  </group>
  <group name="Music" gain="-3dB">
    <effect type="eq" low="1" mid="-0.5" high="1.2" mid_freq="1200"/>
    <effect type="stereo" width="1.15"/>
    <automation target="pan" points="0:-0.05; 32:0.05"/>
  </group>
  <bus name="Reverb" gain="-3dB">
    <effect type="reverb" size="0.7" decay="2.6" tone="0.55" mix="1"/>
  </bus>
  <master>
    <effect type="limiter" ceiling="-1" release="100"/>
  </master>
  <track file="tracks/kick.track.xml"/>
  <track file="tracks/snare.track.xml"/>
  <track file="tracks/hat.track.xml"/>
  <track file="tracks/bass.track.xml"/>
  <track file="tracks/piano.track.xml"/>
  <track file="tracks/pad.track.xml"/>
</musicproj>
